{
    "version": "0.1.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xueca/agent-audit-mcp.git"
    },
    "files": [
        "dist/",
        "!dist/tests",
        "!dist/examples",
        "README.md",
        "LICENSE",
        "docs/usage.md",
        "docs/cg-integration.md",
        "package.json",
        "tsconfig.json"
    ],
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^8.57.0",
        "typescript": "^5.5.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "zod": "^3.23.0"
    },
    "name": "@xueca/agent-audit-mcp",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && node --test dist/tests/*.test.js",
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"sdk/**/*.ts\" \"examples/**/*.ts\"",
        "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm run test"
    },
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "default": "./dist/src/index.js"
        },
        "./sdk": {
            "types": "./dist/sdk/index.d.ts",
            "default": "./dist/sdk/index.js"
        },
        "./package.json": "./package.json"
    },
    "description": "Protocol-level behavioral audit MCP Server for AI Agents",
    "engines": {
        "node": ">=21.0.0"
    },
    "license": "MIT",
    "keywords": [
        "mcp",
        "agent",
        "audit",
        "observability",
        "tracing",
        "behavior-audit",
        "event-sourcing"
    ],
    "author": "xueca",
    "homepage": "https://github.com/xueca/agent-audit-mcp",
    "main": "dist/src/index.js",
    "bin": {
        "agent-audit": "dist/src/cli.js"
    }
}
